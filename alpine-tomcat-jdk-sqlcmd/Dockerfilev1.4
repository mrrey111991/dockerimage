# ===== Stage 0: Download sqlcmd (minimal downloader stage, no Go runtime) =====
FROM alpine:3.22 AS build

RUN apk add --no-cache curl tar bzip2 ca-certificates

WORKDIR /tmp

# Download sqlcmd release and optionally verify checksum
ARG SQLCMD_URL="https://github.com/microsoft/go-sqlcmd/releases/latest/download/sqlcmd-linux-amd64.tar.bz2"
ARG SQLCMD_SHA256=""

RUN set -eux; \
    curl -fL --retry 5 --retry-delay 2 -o sqlcmd.tar.bz2 "$SQLCMD_URL"; \
    if [ -n "$SQLCMD_SHA256" ]; then \
      echo "${SQLCMD_SHA256}  sqlcmd.tar.bz2" > sqlcmd.sha256; \
      sha256sum -c sqlcmd.sha256; \
      rm -f sqlcmd.sha256; \
    else \
      echo "No SQLCMD_SHA256 provided — skipping checksum verification"; \
    fi; \
    mkdir -p /out; \
    tar -xjf sqlcmd.tar.bz2 -C /out; \
    chmod +x /out/sqlcmd; \
    rm -f sqlcmd.tar.bz2

# ===== Stage 1: Runtime image (Debian-based minimal) =====
FROM eclipse-temurin:21-jdk-jammy

ENV CATALINA_HOME=/usr/local/tomcat
ENV PATH="$CATALINA_HOME/bin:$PATH"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl tar gnupg; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd -r tomcat && useradd -r -g tomcat -d "$CATALINA_HOME" -s /sbin/nologin tomcat

# Copy sqlcmd from build stage (no Go runtime carried into final image)
COPY --from=build /out/sqlcmd /usr/local/bin/sqlcmd
RUN chmod 755 /usr/local/bin/sqlcmd && sqlcmd --version || true

# Download and verify Tomcat tarball (use official checksums when available)
ARG TOMCAT_VERSION=11.0.24
ARG TOMCAT_BASE="apache-tomcat-${TOMCAT_VERSION}"
ARG TOMCAT_TGZ_URL="https://downloads.apache.org/tomcat/tomcat-11/v${TOMCAT_VERSION}/bin/${TOMCAT_BASE}.tar.gz"
ARG TOMCAT_ALT_URL="https://archive.apache.org/dist/tomcat/tomcat-11/v${TOMCAT_VERSION}/bin/${TOMCAT_BASE}.tar.gz"
ARG TOMCAT_SHA512=""

RUN set -eux; \
    mkdir -p "$CATALINA_HOME"; \
    if curl -fL --retry 5 --retry-delay 2 -o /tmp/tomcat.tgz "$TOMCAT_TGZ_URL"; then :; \
    else curl -fL --retry 5 --retry-delay 2 -o /tmp/tomcat.tgz "$TOMCAT_ALT_URL"; fi; \
    if curl -fsS --retry 3 -o /tmp/tomcat.tgz.sha512 "${TOMCAT_TGZ_URL}.sha512"; then \
        awk '{print $1 "  /tmp/tomcat.tgz"}' /tmp/tomcat.tgz.sha512 > /tmp/tomcat.tgz.sha512.fixed; \
        sha512sum -c /tmp/tomcat.tgz.sha512.fixed || (echo "Tomcat sha512 mismatch" && exit 1); \
        rm -f /tmp/tomcat.tgz.sha512.fixed /tmp/tomcat.tgz.sha512; \
    else \
        if [ -n "$TOMCAT_SHA512" ]; then \
          echo "${TOMCAT_SHA512}  /tmp/tomcat.tgz" > /tmp/tomcat.tgz.sha512; \
          sha512sum -c /tmp/tomcat.tgz.sha512 || (echo "Tomcat sha512 mismatch (provided value)" && exit 1); \
          rm -f /tmp/tomcat.tgz.sha512; \
        else \
          echo "No TOMCAT_SHA512 provided and official .sha512 not available — skipping Tomcat checksum verification"; \
        fi; \
    fi; \
    tar -xzf /tmp/tomcat.tgz -C "$CATALINA_HOME" --strip-components=1; \
    rm -f /tmp/tomcat.tgz; \
    chmod +x "$CATALINA_HOME"/bin/*.sh; \
    chown -R tomcat:tomcat "$CATALINA_HOME"

EXPOSE 8080

USER tomcat

CMD ["catalina.sh", "run"]
